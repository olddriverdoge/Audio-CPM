<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ 读音频文件（媒体库路径） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 11+ 全盘路径 (/sdcard) 读取，需要用户在系统设置里手动授予 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 6~10 的老权限，targetSdk 35 下不再由系统自动授予 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- HiFi 播放的前台服务与通知栏 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 本地 HTTP 服务保活：Android 14+ 需要声明 specialUse 前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 引导用户把本应用加入电池优化白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MediaSession 在锁屏/通知栏显示媒体控制 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 全局悬浮窗（播放管理）：需要用户手动授予“显示在其他应用上层” -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".AudioCpmApp"
        android:label="Audio-CPM"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:theme="@style/AudioCpmTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 外部播放器用的只读 content:// 提供者 -->
        <provider
            android:name=".AudioCpmFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- HiFi 播放服务：ExoPlayer + MediaSession（通知栏 / 锁屏 / 后台） -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 全局悬浮窗：独立 WebView 承载播放管理，盖在其他 App 上层 -->
        <service
            android:name=".FloatingPlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="playback_overlay" />
        </service>

        <!-- 本地 HTTP 服务保活：浏览器在后台访问 127.0.0.1:8765 时保持进程存活 -->
        <service
            android:name=".ServerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_http_server" />
        </service>
    </application>
</manifest>
