<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ 读音频文件（媒体库路径） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 11+ 全盘路径 (/sdcard) 读取，需要用户在系统设置里手动授予 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 6~10 的老权限，targetSdk 35 下不再由系统自动授予 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- HiFi 播放的前台服务与通知栏 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MediaSession 在锁屏/通知栏显示媒体控制 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AudioCpmApp"
        android:label="Audio-CPM"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 外部播放器用的只读 content:// 提供者 -->
        <provider
            android:name=".AudioCpmFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- HiFi 播放服务：ExoPlayer + MediaSession（通知栏 / 锁屏 / 后台） -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
